SUMMARY="A cute mascot on the active window"
DESCRIPTION="Moeca is a program that displays a cute mascot on the active window. \
It is part of the Pirati Del Frico project and it is intended to show a cute \
crab, powered by the Haiku's integrated AI infrastructure. \
You can have your own 'window sitter' by drag and dropping an image (best \
a transparancy preserving PNG) onto the Moeca binary. Do read the \
accompanying documentation to learn about all options and how to set up \
animated mascots. \
Moeca handles multiple animations and you can chat with it and make it perform \
actions if you configure properly the AI preflet."
HOMEPAGE="https://github.com/tmtfx/Moeca"
COPYRIGHT="
	2001 Okada Jun
	2001 Yu-Ki
	2021 Cafeina
	2026 atomozero
	2026 TmTFx
	"
LICENSE="GNU GPL v2"
REVISION="1"
srcGitRev="1.2"
SOURCE_URI="$HOMEPAGE/archive/refs/tags/$srcGitRev.tar.gz"
CHECKSUM_SHA256="5c3137efb5b7bceb32f5aa0d474c86be257fbf66ad65989700576cb52b21418c"
#SOURCE_DIR="Moeca-$srcGitRev"
SOURCE_DIR="Moeca-$srcGitRev"
ADDITIONAL_FILES="moeca_postinstall.sh"

ARCHITECTURES="all"

PROVIDES="
	moeca = $portVersion
	moe = $portVersion
	app:Moeca = $portVersion
	cmd:moeca = $portVersion
	"
REQUIRES="
	haiku
	lib:libz
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libz
	"
BUILD_PREREQUIRES="
	makefile_engine
	cmd:gcc
	cmd:ld
	cmd:make
	"

POST_INSTALL_SCRIPTS="$relativePostInstallDir/moeca_postinstall.sh"

BUILD()
{
	cd sample
	./add_attributes.sh

	cd ../source
	make OBJ_DIR=objects $jobArgs
	make OBJ_DIR=objects bindcatalogs

	chmod +x moeca.run
	./moeca.run
}

INSTALL()
{
	mkdir -p $appsDir/Moeca $binDir

	cp -a source/objects/Moeca $appsDir/Moeca
	cp -a sample/moe.png documentation $appsDir/Moeca
	cp -a source/moeca_small.png $appsDir/Moeca

	ln -sfn $appsDir/Moeca/Moeca $binDir/moeca

	mkdir -p $postInstallDir
	install -t $postInstallDir -m 755 $portDir/additional-files/moeca_postinstall.sh
}
